# This repository (the designer definition) is checked out at the agent's HOME
# root (/home/agent), which also contains secrets and runtime state (.ssh, .claude,
# .config, work/, ...). To make `git add -A` safe and never capture those, ignore
# EVERYTHING at the top level by default, then re-include only the definition files this
# repo actually tracks.
#
# NOTE: NOTHING under work/ is tracked — the brand, repo profiles and outputs are
# runtime state, seeded at onboarding. The `/*` rule hides every untracked top-level
# path; only the re-included definition files are versioned.

/*

!/.gitignore
!/CLAUDE.md
!/AGENTS.md
!/README.md
!/ONBOARDING.md
!/kit.yaml
!/VERSION
!/CHANGELOG.md
!/LICENSE
!/docs/
!/scripts/
!/.github/
!/toolkit/
/toolkit/node_modules/

# Runtime skill installs land in .agents/skills/ too, so the bundled ones are
# re-included BY NAME — otherwise a cached install becomes definition content.
!/.agents/
/.agents/skills/*
!/.agents/skills/prototype/
!/.agents/skills/walkthrough/
!/.agents/skills/slides/
!/.agents/skills/demo-video/
!/.agents/skills/brand/
!/.agents/skills/copy/

# Never track these even if a future allowlist entry would pull them in.
.DS_Store
.claude/settings.local.json
